{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solar independent evidence review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "agent", "boundary_sha256", "generated_at", "verdict", "reviewed_sha256", "issues", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"const": "evidence_reviewer"},
    "boundary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "verdict": {"enum": ["ready", "needs_revision"]},
    "reviewed_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "summary": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["agent", "indicator", "severity", "evidence", "requested_correction"],
        "properties": {
          "agent": {"enum": ["coordinator", "land_environment", "grid_access", "planning"]},
          "indicator": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocking", "note"]},
          "evidence": {"type": "string", "minLength": 1},
          "requested_correction": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
