{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solar specialist result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "agent", "boundary_sha256", "generated_at", "metrics", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"enum": ["land_environment", "grid_access", "planning"]},
    "boundary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_url", "retrieved_at", "data_date", "evidence_locator"],
      "properties": {
        "source_url": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "data_date": {"type": ["string", "null"]},
        "evidence_locator": {"type": "string", "minLength": 1}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["indicator", "status", "value", "sources", "spatial_scope", "method", "limitations", "evidence_files", "reason"],
      "properties": {
        "indicator": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "provided", "estimated", "needs_review", "skipped"]},
        "value": {},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "spatial_scope": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "evidence_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
